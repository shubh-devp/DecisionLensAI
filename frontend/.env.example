# Frontend build configuration.
#
# Copy to .env.local for development overrides. Never commit real secrets here —
# everything in this file ends up in the browser bundle, because Vite inlines
# VITE_* variables at build time.

# Base URL of the Flask backend.
#
#   unset  -> http://127.0.0.1:5000   (the local development default)
#   set    -> that value is used as-is; trailing slashes are trimmed
#   empty  -> the app calls its own origin, i.e. /api/... on the same domain
#
# Production: the frontend is a static site and the backend is a web service, so
# they live on different origins. Set this to the backend's public URL at build
# time, e.g.
#   VITE_API_BASE_URL=https://decisionlens-api.onrender.com
VITE_API_BASE_URL=

# NEVER put the LLM API key here. It belongs to the backend only, and anything
# with a VITE_ prefix is visible to anyone who opens the built JavaScript.
