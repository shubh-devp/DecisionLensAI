# Root-level backend configuration example.
#
# The Flask backend reads these from the real process environment. It does NOT
# load this file automatically. Copy the values you need into your shell for
# local development, or into your host's environment-variable settings (e.g.
# the Render dashboard) for production. Never commit a real key.

# --- AI narration (optional) ------------------------------------------------
# Without LLM_API_KEY, /api/health, /api/upload, /api/analyze, /api/evidence
# and /api/anomalies all keep working. Only /api/insights,
# /api/recommendations and /api/ask need a key.
LLM_API_KEY=your-provider-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- Server settings -------------------------------------------------------
# Comma-separated browser origins allowed to call this API. Defaults to the
# local Vite dev server. In production, set this to your deployed frontend
# origin only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enables Flask's interactive debugger. Leave unset (off) in production.
FLASK_DEBUG=0
